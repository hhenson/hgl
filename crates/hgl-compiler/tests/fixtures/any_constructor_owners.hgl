module hgraph.std part mixed_box_probe
struct MixedChain { value:i64
    items:list<i64>
    next:atomic<MixedChain> = null
}
test {
    fn mixed_box(value:i64)->any {
        when {
            let chain=MixedChain(value:value,items:[1,2],next:MixedChain(value:value,items:[]))
            let seen=chain.value
            if seen >= 0 { return any(chain) } else { return any() }
        }
    }
    test native_read_then_box {
        assert eval(mixed_box,[1,2])==[
            any(MixedChain(value:1,items:[1,2],next:MixedChain(value:1,items:[]))),
            any(MixedChain(value:2,items:[1,2],next:MixedChain(value:2,items:[])))]
    }
}

struct OrderedOwner { first:i64
    second:i64
    items:list<i64>
}
native const fn owner_begin(value:i64) throws
native const fn owner_begin(value:i64) throws {}
native const fn owner_mark(value:i64)->i64 throws
native const fn owner_mark(value:i64)->i64 throws {}
native const fn owner_finish(value:i64) throws
native const fn owner_finish(value:i64) throws {}
test {
    fn ordered_local(value:i64)->any {
        start { owner_begin(0) }
        stop { owner_finish(0) }
        when {
            let record=OrderedOwner(second:owner_mark(2),first:owner_mark(1),items:[1,2])
            let first=record.first
            if first==1 {return any(record)} else {return any()}
        }
    }
    fn ordered_inline(value:i64)->any {
        start { owner_begin(0) }
        stop { owner_finish(0) }
        when {return any(OrderedOwner(second:owner_mark(2),first:owner_mark(1),items:[1,2]))}
    }
    test constructor_operands_run_once_in_written_order {
        assert eval(ordered_local,[1,2])==[any(OrderedOwner(first:1,second:2,items:[1,2])),any(OrderedOwner(first:1,second:2,items:[1,2]))]
        assert eval(ordered_inline,[1,2])==[any(OrderedOwner(first:1,second:2,items:[1,2])),any(OrderedOwner(first:1,second:2,items:[1,2]))]
    }
}

struct KeptBoxes { initial:any
    replacement:any
}
test {
    fn retained_owner_field(value:i64)->any {
        when {
            let record=KeptBoxes(initial:any(value),replacement:any(value+1))
            let initial=record.initial
            var replacement=any(record)
            replacement=any(value+2)
            return any(KeptBoxes(initial:initial,replacement:replacement))
        }
    }
    test selected_owner_fields_are_retained_before_another_box_is_replaced {
        assert eval(retained_owner_field,[1,2])==[
            any(KeptBoxes(initial:any(1),replacement:any(3))),
            any(KeptBoxes(initial:any(2),replacement:any(4)))]
    }
}
