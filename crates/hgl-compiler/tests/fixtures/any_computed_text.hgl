module hgraph.std part any_computed_text
fn duplicate_text(value:str)->any { when { return any(value+value) } }
test long_computed_text_uses_combined_width {
    assert eval(duplicate_text,[""]) == [any("") ]
    assert eval(duplicate_text,["", "", "x", "yz", ""]) == [any(""), any(""), any("xx"), any("yzyz"), any("")]
}

struct TextLeaf { text:str
    mark:i64 }
struct TextBox { text:str
    boxed:any }
fn nested_text(value:str)->any {
    when {return any(TextBox(text:(value+"!")+value,
        boxed:any(TextLeaf(text:value+(value+value),mark:7))))}
}
test nested_concat_keeps_each_box_descriptor_and_text_frame {
    assert eval(nested_text,[""]) == [any(TextBox(text:"!",boxed:any(TextLeaf(text:"",mark:7))))]
    assert eval(nested_text,["", "xy", "z"]) == [
        any(TextBox(text:"!",boxed:any(TextLeaf(text:"",mark:7)))),
        any(TextBox(text:"xy!xy",boxed:any(TextLeaf(text:"xyxyxy",mark:7)))),
        any(TextBox(text:"z!z",boxed:any(TextLeaf(text:"zzz",mark:7))))]
}

native const fn text_mark(value:i64)->i64
native const fn text_mark(value:i64)->i64 { rust_abi_node_result }
native const fn text_fail(value:i64)->i64
native const fn text_fail(value:i64)->i64 { rust_abi_node_result }
native const fn text_finish(value:i64)
native const fn text_finish(value:i64) { rust_abi_node_result }
struct OrderedText { first:str
    second:i64
    boxed:any }
fn ordered_text(value:str)->any {
    stop {text_finish(21)}
    when {return any(OrderedText(second:text_mark(2),first:value+value,
        boxed:any(TextLeaf(text:value+("!"+value),mark:text_mark(1)))))}
}
fn failed_text(value:str)->any {
    stop {text_finish(2)}
    when {return any(OrderedText(second:text_fail(2),first:value+value,
        boxed:any(TextLeaf(text:value+value,mark:text_mark(1)))))}
}
test computed_text_preserves_effect_order_and_failure_short_circuit {
    assert eval(ordered_text,["hi"]) == [any(OrderedText(first:"hihi",second:2,
        boxed:any(TextLeaf(text:"hi!hi",mark:1))))]
    assert raises("yield.negative_duration") {eval(failed_text,["hi"])}
}

fn projected_text(index:i64,const values:list<str>)->any {
    when {return any(values[index]+values[0])}
}
fn projected_field(index:i64,const value:TextLeaf)->any {
    when {return any(value.text+value.text)}
}
fn text_generator(const values:list<str>)->any {
    yield 0us:any(values[0]+values[1])
    yield 1us:any(values[2]+values[0])
}
fn consume_text_tick(tick:i64) {when {}}
fn drive_text_generator(tick:i64,const values:list<str>)->any {
    consume_text_tick(tick)
    text_generator(values)
}
fn drive_projected_text(index:i64)->any {projected_text(index,["","","x"])}
fn drive_projected_field(index:i64)->any {projected_field(index,TextLeaf(text:"",mark:7))}
fn drive_configuration_generator(tick:i64)->any {drive_text_generator(tick,["","x",""])}
test immutable_configuration_projections_and_generator_concat {
    assert eval(drive_projected_text,[0,1,2]) == [any(""),any(""),any("")]
    assert eval(drive_projected_field,[1]) == [any("")]
    assert eval(drive_configuration_generator,[1,1,1]) == [any(""),any(""),_]
}
fn projected_order(value:i64,const values:list<str>)->any {
    stop {text_finish(12)}
    when {return any(values[text_mark(1)]+values[text_mark(2)])}
}
fn projected_failure(value:i64,const values:list<str>)->any {
    stop {text_finish(1)}
    when {return any(values[text_fail(1)]+values[text_mark(2)])}
}
fn drive_projected_order(value:i64)->any {projected_order(value,["unused","first","second"])}
fn drive_projected_failure(value:i64)->any {projected_failure(value,["unused","first","second"])}
test projection_indices_execute_once_before_the_next_text_operand {
    assert eval(drive_projected_order,[1]) == [any("firstsecond")]
    assert raises("yield.negative_duration") {eval(drive_projected_failure,[1])}
}
