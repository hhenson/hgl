module capture_declared_ref
fn route(value:ref<i64>)->ref<i64> {when {return value}}
fn read(value:i64)->i64 {when {return value}}
fn observed(value:i64)->i64 {let seen=capture(route,value)
read(seen.value)}
fn absent(value:ref<i64>)->ref<i64> {when false {return value}}
fn choose(index:i64,first:ref<i64>,second:ref<i64>,empty:ref<i64>)->ref<i64> {
when valid(index) && modified(index) {
if index==0 {return first}
if index==1 {return second}
return empty}}
fn inspect(reference:ref<i64>,data:i64,step:i64)->atomic<tuple<bool,bool,bool,bool,i64>> {
when valid(step) && modified(step) {
var seen:i64 = -1
if valid(data) {seen=data}
return (valid(reference),modified(reference),valid(data),modified(data),seen)}}
fn state(index:i64,first:i64,second:i64,step:i64)->atomic<tuple<bool,bool,bool,bool,i64>> {
let empty=absent(first)
let seen=capture(choose,index,first,second,empty)
inspect(seen.value,seen.value,step)}
fn forward(value:ref<i64>)->ref<i64> => value
fn external(value:i64)->i64 {let selected=route(value)
let seen=capture(forward,selected)
read(seen.value)}
fn inner(value:ref<i64>)->ref<i64> {let seen=capture(route,value)
seen.value}
fn nested(value:i64)->i64 {let seen=capture(inner,value)
read(seen.value)}
struct Pair {left:i64
right:i64}
fn pair_route(value:ref<Pair>)->ref<Pair> {when {return value}}
fn pair_read(value:i64)->i64 {when {return value}}
fn pair_capture(value:Pair)->i64 {let seen=capture(pair_route,value)
pair_read(seen.value.left)}
fn owned(enabled:bool,first:i64,second:i64)->ref<i64> {
var selected:ref<i64>
if enabled {let child=read(first)
let seen=capture(route,child)
selected=seen.value}
else {let child=read(second)
let seen=capture(route,child)
selected=seen.value}
selected}
fn first_ref(value:ref<i64>)->ref<i64> {state held:bool = false
when {if !held {held=true
return value}}}
fn lifetime_state(old:i64,current:i64,step:i64)->atomic<tuple<bool,bool,i64,bool,bool,i64>> {
when valid(step) && modified(step) {
var previous:i64 = -1
var next:i64 = -1
if valid(old) {previous=old}
if valid(current) {next=current}
return (valid(old),modified(old),previous,valid(current),modified(current),next)}}
fn lifetime(enabled:bool,first:i64,second:i64,step:i64)->atomic<tuple<bool,bool,i64,bool,bool,i64>> {
let selected=owned(enabled,first,second)
lifetime_state(first_ref(selected),selected,step)}
test live {
assert eval(observed,value:[1,_,2])==[1,_,2]
assert eval(state,index:[_,0,_,1,1,2,_,0,_],first:[_,_,7,_,_,_,9,_,10],second:[7],step:[0,1,2,3,4,5,6,7,8])==[
(false,false,false,false,-1),
(true,true,false,false,-1),
(true,false,true,true,7),
(true,true,true,true,7),
(true,false,true,false,7),
(true,true,false,false,-1),
(true,false,false,false,-1),
(true,true,true,true,9),
(true,false,true,true,10)]
assert eval(external,value:[1,_,2])==[1,_,2]
assert eval(nested,value:[1,_,2])==[1,_,2]
assert eval(pair_capture,value:[delta<Pair>(left:7),delta<Pair>(right:20),delta<Pair>(left:9)])==[7,_,9]
assert eval(lifetime,enabled:[true,false,false,true,_],first:[7,8,9,10,11],second:[20,21,22,23,24],step:[0,1,2,3,4])==[
(true,true,7,true,true,7),
(true,false,7,true,true,21),
(false,false,-1,true,true,22),
(false,false,-1,true,true,10),
(false,false,-1,true,true,11)]
}
