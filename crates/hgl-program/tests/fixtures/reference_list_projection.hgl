module hgraph.std part reference_list_projection_tests

test {
    struct RoutingPair {
        left:i64
        right:i64
    }
    fn finite_route<T>(index:i64,values:list<ref<T>,3>)->ref<T> {
        when valid(index) && index >= 0 && index < 3 && valid(values[index]) && (modified(index) || modified(values[index])) {
            return values[index]
        }
    }
    fn finite_read<T>(value:T)->T { when { return delta_value(value) } }
    fn projected_pair(index:i64,first:RoutingPair,second:RoutingPair,third:RoutingPair)->i64 {
        let selected = finite_route(index,[first,second,third])
        finite_read(selected.left)
    }
    test selected_reference_keeps_graph_nominal_projection_live {
        assert eval(projected_pair,
            index:[0,_,1,_,1,0,_],
            first:[delta<RoutingPair>(left:7),delta<RoutingPair>(right:10),_,delta<RoutingPair>(left:9),_,_,delta<RoutingPair>(left:10)],
            second:[delta<RoutingPair>(left:7),_,_,delta<RoutingPair>(left:8)],
            third:[delta<RoutingPair>()]
        ) == [7,_,7,8,_,9,10]
    }
    fn projected_list(index:i64,first:list<i64,2>,second:list<i64,2>,third:list<i64,2>)->i64 {
        let selected = finite_route(index,[first,second,third])
        finite_read(selected[1])
    }
    test selected_reference_keeps_graph_constant_list_projection_live {
        assert eval(projected_list,
            index:[0,_,1,_,1,0,_],
            first:[delta<list<i64,2>>(items:[1:7]),delta<list<i64,2>>(items:[0:10]),_,delta<list<i64,2>>(items:[1:9]),_,_,delta<list<i64,2>>(items:[1:10])],
            second:[delta<list<i64,2>>(items:[1:7]),_,_,delta<list<i64,2>>(items:[1:8])],
            third:[delta<list<i64,2>>(items:[])]
        ) == [7,_,7,8,_,9,10]
    }
    fn projected_assembly(index:i64,first:i64,second:i64,third:i64)->i64 {
        let first_pair = RoutingPair(left:first,right:second)
        let second_pair = RoutingPair(left:second,right:third)
        let selected = finite_route(index,[first_pair,second_pair,first_pair])
        finite_read(selected.left)
    }
    test reference_list_keeps_nominal_assembly_entries_opaque {
        assert eval(projected_assembly,index:[0,_,1,_,1,2,_],first:[7,8,_,_,_,9,10],second:[7,_,_,8],third:[20]) == [7,8,7,8,_,9,10]
    }
    fn entry_reference(value:ref<i64>)->ref<i64> {when {return value}}
    fn owned_entry(enabled:bool,first:i64,second:i64)->ref<i64> {
        var selected:ref<i64>
        if enabled {selected = entry_reference(pass_through(first))}
        else {selected = entry_reference(pass_through(second))}
        selected
    }
    fn follow_owned_entry(index:i64,enabled:bool,first:i64,second:i64,third:i64)->i64 {
        let owner = owned_entry(enabled,first,second)
        let selected = finite_route(index,[owner,third,first])
        finite_read(selected)
    }
    test reference_list_keeps_conditional_owner_carriers_live {
        assert eval(follow_owned_entry,index:[0,_,_,_,1,_,0,_],enabled:[true,_,false,_,_,true],first:[7,8,9,10,11,12,13,14],second:[20,21,22,23,24,25,26,27],third:[30,31,32,33,34,35,36,37]) == [7,8,22,23,34,35,13,14]
    }
    fn alias_route(index:i64,values:list<ref<i64>,3>)->ref<i64> {
        when valid(index) && index >= 0 && index < 3 && valid(values[index]) && (modified(index) || modified(values[index])) {
            let picked = values[index]
            return picked
        }
    }
    fn followed_alias(index:i64,first:i64,second:i64,third:i64)->i64 => finite_read(alias_route(index,[first,second,third]))
    test selected_reference_alias_keeps_designation_flow {
        assert eval(followed_alias,index:[0,_,0,1,_,1,2],first:[7,8],second:[7,_,_,_,9],third:[7]) == [7,8,_,7,9,_,7]
    }
    const fn ordinary_empty()->list<i64> => []
    fn configured_size(const values:list<list<i64>,1>)->i64 {yield 0us:len(values[0])}
    fn configured_sum(const values:list<i64,2>)->i64 {yield 0us:values[0]+values[1]}
    fn contextual_ordinary()->i64 => configured_size([ordinary_empty()])
    fn positional_ordinary()->i64 => configured_sum([7,9])
    test ordinary_graph_lists_preserve_context_and_positions {
        assert eval(contextual_ordinary) == [0]
        assert eval(positional_ordinary) == [16]
    }
}
