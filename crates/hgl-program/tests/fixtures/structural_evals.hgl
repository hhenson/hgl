module structural_evals
struct Quote { bid:i64
ask:str }
fn identity<T>(value:T)->T {when {return delta_value(value)}}
test canonical_sparse_order {
 assert eval(identity,[delta<set<i64>>(added:[2,1]),_,delta<set<i64>>(removed:[2]),delta<set<i64>>(removed:[1],added:[-1])]) == [delta<set<i64>>(added:[1,2]),_,delta<set<i64>>(removed:[2]),delta<set<i64>>(added:[-1],removed:[1])]
 assert eval(identity,[delta<list<i64,3>>(items:[2:30,0:10]),_,delta<list<i64,3>>(items:[0:10])]) == [delta<list<i64,3>>(items:[0:10,2:30]),_,delta<list<i64,3>>(items:[0:10])]
 assert eval(identity,[delta<tuple<i64,str>>(items:[1:"",0:0]),delta<tuple<i64,str>>(items:[0:0])]) == [delta<tuple<i64,str>>(items:[0:0,1:""]),delta<tuple<i64,str>>(items:[0:0])]
 assert eval(identity,[delta<Quote>(ask:"old",bid:1),delta<Quote>(ask:"new"),delta<Quote>(bid:1)]) == [delta<Quote>(bid:1,ask:"old"),delta<Quote>(ask:"new"),delta<Quote>(bid:1)]
 assert eval(identity,[delta<map<i64,list<Quote,2>>>(upsert:[9:delta<list<Quote,2>>(items:[1:delta<Quote>(ask:"old",bid:1)]),-3:delta<list<Quote,2>>(items:[0:delta<Quote>(bid:2)])]),delta<map<i64,list<Quote,2>>>(upsert:[9:delta<list<Quote,2>>(items:[1:delta<Quote>(ask:"new")])]),delta<map<i64,list<Quote,2>>>(remove:[9,-3])]) == [delta<map<i64,list<Quote,2>>>(upsert:[-3:delta<list<Quote,2>>(items:[0:delta<Quote>(bid:2)]),9:delta<list<Quote,2>>(items:[1:delta<Quote>(bid:1,ask:"old")])]),delta<map<i64,list<Quote,2>>>(upsert:[9:delta<list<Quote,2>>(items:[1:delta<Quote>(ask:"new")])]),delta<map<i64,list<Quote,2>>>(remove:[-3,9])]
}

struct Wide {
f0:i64
f1:i64
f2:i64
f3:i64
f4:i64
f5:i64
f6:i64
f7:i64
f8:i64
f9:i64
f10:i64
f11:i64
f12:i64
}
test wide_struct {assert eval(identity,[delta<Wide>(f12:1,f0:2)]) == [delta<Wide>(f0:2,f12:1)]}

struct Defaulted<T> {
    required:T
    fallback:i64=42
    label:str="default"
}
fn defaulted(value:Defaulted<str>)->Defaulted<str> => identity(value)
test generic_defaulted_sparse_fields {
 assert eval(defaulted,[delta<Defaulted<str>>(required:""),_,delta<Defaulted<str>>(fallback:0),delta<Defaulted<str>>(label:""),delta<Defaulted<str>>(fallback:0)]) == [delta<Defaulted<str>>(required:""),_,delta<Defaulted<str>>(fallback:0),delta<Defaulted<str>>(label:""),delta<Defaulted<str>>(fallback:0)]
 assert eval(defaulted,[_,_]) == [_,_]
 assert eval(defaulted,[]) == []
}

fn zero_size(value:list<i64,0>)->list<i64,0> => identity(value)
test zero_size_lists_allow_empty_and_silent_traces {
 assert eval(zero_size,[]) == []
 assert eval(zero_size,[_,_]) == [_,_]
}
